# The one API key. SDKs send it as E2B_API_KEY.
E2B_API_KEY=

# Optional
#LISTEN_ADDR=:3000
# How SDK clients reach the API, used for template file upload URLs.
#PUBLIC_URL=http://e2b.internal:3000
# Wildcard domain for <port>-<sandboxID>.<domain> URLs (sandbox.getHost()).
#SANDBOX_DOMAIN=e2b.internal
# 2 MiB hugepages reserved for sandbox memory (2048 = 4 GiB).
#HUGEPAGES=2048
#MAX_SANDBOX_HOURS=24
#PF_MIN_FREE_GIB=20
# Size of the base template and of builds that do not ask for one.
#DEFAULT_CPU_COUNT=2
#DEFAULT_MEMORY_MB=512
