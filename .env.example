# Optional API key. Unset: no check, every request is allowed (private
# networks only). Set: SDKs must send the same value as E2B_API_KEY.
#E2B_API_KEY=

#LISTEN_ADDR=:3000
# How SDK clients reach the API, used for local template upload URLs.
#PUBLIC_URL=http://e2b.internal:3000
# Wildcard domain for <port>-<sandboxID>.<domain> URLs (sandbox.getHost()).
#SANDBOX_DOMAIN=e2b.internal

# --- State: Postgres, or SQLite (E2B_DATA_DIR/minimal/state.db) when unset
#DATABASE_URL=postgres://e2b:secret@db.internal:5432/e2b

# --- Templates and snapshots on S3 (any S3-compatible store); unset keeps them on disk
#S3_BUCKET=e2b-templates
#S3_BUILD_CACHE_BUCKET=e2b-build-cache
#S3_ENDPOINT=https://s3.example.com
#S3_REGION=us-east-1
#S3_FORCE_PATH_STYLE=true
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=us-east-1

# --- Everything else (sandbox disks, snapshot cache, local state) in this host
# directory; make it its own disk or mount if you like.
#E2B_DATA_DIR=/var/lib/e2b

# --- Memory and CPU
# regular: sandboxes take host memory as they use it (default).
# hugepages: E2B's default, a fixed pool of 2 MiB pages (HUGEPAGES of them).
#MEMORY_MODE=regular
# All sandboxes together, in MiB / cores. Unset = no limit.
#SANDBOX_ALL_MEMORY_MAX=24576
#SANDBOX_ALL_CPU_MAX=8
# Per sandbox: memory every running sandbox is guaranteed, in MiB (regular mode).
#SANDBOX_MEMORY_MIN=256
# Size of templates that do not ask for one: the most a sandbox can use.
# The CPU count defaults to all host cores.
#DEFAULT_MEMORY_MB=4096
#DEFAULT_CPU_COUNT=
# Start new sandboxes by booting instead of restoring the template's memory
# snapshot: ~1.5 s instead of ~0.2 s, but fresh memory comes at full speed.
#COLD_BOOT=false
#HUGEPAGES=2048

#MAX_SANDBOX_HOURS=24
#PF_MIN_FREE_GIB=20
